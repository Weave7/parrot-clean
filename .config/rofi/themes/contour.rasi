/* Contour theme - matches the i3 palette. White marks the selected row
 * only; everything else stays grayscale. Fully opaque - no transparency. */

* {
    ground:       #060606;
    surface:      #0a0a0a;
    hairline:     #1f1f1f;
    text-dim:     #52525b;
    text-label:   #71717a;
    text-2nd:     #a1a1aa;
    text-primary: #ededed;
    focus:        #ffffff;

    background-color: transparent;
    text-color:        @text-primary;
    font:              "Geist Mono 12";
}

window {
    background-color: @surface;
    border:           1px;
    border-color:     @hairline;
    border-radius:    0px;
    width:            600px;
    location:         center;
}

mainbox {
    background-color: @surface;
    padding: 8px;
}

inputbar {
    background-color: @ground;
    text-color:        @text-primary;
    border:            0px 0px 1px 0px;
    border-color:      @hairline;
    padding:           10px;
    children:          [ "entry" ];
}

entry {
    background-color: transparent;
    text-color:        @text-primary;
    placeholder-color: @text-label;
    placeholder:       "search";
}

listview {
    background-color: transparent;
    lines:             15;
    columns:           3;
    spacing:           2px;
    scrollbar:         false;
}

element {
    background-color: transparent;
    text-color:        @text-2nd;
    padding:           6px 10px;
    border-radius:     0px;
}

element selected {
    background-color: @hairline;
    text-color:        @focus;
    border:            0px 0px 0px 2px;
    border-color:      @focus;
}

element-text {
    background-color: transparent;
    text-color:        inherit;
}
