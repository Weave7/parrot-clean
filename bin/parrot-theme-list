#!/bin/bash
set -e

THEMES_DIR="${PARROT_THEMES_DIR:-$HOME/.config/parrot/themes}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -d "$THEMES_DIR" ] || THEMES_DIR="$(dirname "$SCRIPT_DIR")/themes"

if [ ! -d "$THEMES_DIR" ]; then
    echo "No themes directory found at $THEMES_DIR"
    exit 1
fi

find -L "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort -u
